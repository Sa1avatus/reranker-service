map $http_x_backend $upstream_host {
  default   "";
  ""        "${RERANKER_UPSTREAM}";
  "${RERANKER_DEFAULT_BACKEND}" "${RERANKER_UPSTREAM}";
}

server {
  listen 8200;

  # Docker embedded DNS resolver.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Static backend registry — UI reads this to discover available backends
  # and map each model to the correct backend for routing.
  location = /v1/backends {
    default_type application/json;
    return 200 '{"default_backend":"${RERANKER_DEFAULT_BACKEND}","backends":[{"id":"${RERANKER_DEFAULT_BACKEND}","name":"${RERANKER_MODEL_NAME}","backend":"${RERANKER_BACKEND_KIND}","available":true}],"model_map":{"${RERANKER_MODEL_NAME}":"${RERANKER_DEFAULT_BACKEND}"}}';
  }

  location / {
    if ($upstream_host = "") {
      return 400 '{"error":{"code":"invalid_backend","message":"unknown X-Backend value","details":null}}';
    }
    proxy_pass http://$upstream_host;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Backend "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    send_timeout 600s;
  }
}
